{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nostr-watchdog",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-22",
  "compatibility_flags": ["nodejs_compat"],
  // Paid Cron Triggers default to 30s of CPU. Free plan Cron CPU is 10ms,
  // which is not enough to build NIP-17 gift wraps. See docs/deployment.md.
  "limits": { "cpu_ms": 30000 },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 1 },
  },
  "triggers": {
    "crons": ["* * * * *", "0 * * * *"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nostr-watchdog",
      "database_id": "00000000-0000-4000-8000-000000000001",
      "migrations_dir": "migrations",
    },
  ],
  "vars": {
    "ENVIRONMENT": "development",
    "WATCHDOG_ENABLED": "true",
    "ALERTS_ENABLED": "true",
    "ADMIN_NPUB": "",
    "PROJECT_RECIPIENTS": "{}",
    "CHECK_CONCURRENCY": "4",
    "CHECK_TIMEOUT_MS": "5000",
    "FAILURE_THRESHOLD": "",
    "RECOVERY_THRESHOLD": "",
    "RELAY_LIST_TTL_SECONDS": "3600",
    "HEARTBEAT_MAX_SKEW_SECONDS": "300",
    "HEARTBEAT_MAX_BODY_BYTES": "4096",
    "HEARTBEAT_STALE_SECONDS": "180",
    "HEARTBEAT_PROGRESS_SECONDS": "600",
    "CRITICAL_REMINDER_SECONDS": "0",
    "UNKNOWN_THRESHOLD": "5",
    "DELIVERY_CLAIM_MS": "120000",
    "SCHEDULER_STALE_SECONDS": "180",
    "TELEGRAM_CRITICAL_MODE": "dual",
    "BOOTSTRAP_RELAYS": "",
    "GITHUB_API_BASE": "https://api.github.com",
    "PRIVATE_NETWORK_PROFILE": "false",
    "RUNBOOK_BASE_URL": "",
    "ENABLE_SFS_WEB": "false",
    "SFS_WEB_READY_URL": "",
    "ENABLE_SFS_WORKER": "false",
    "ENABLE_SFS_BLOSSOM": "false",
    "SFS_BLOSSOM_READY_URL": "",
    "ENABLE_SFS_BLASTR": "false",
    "SFS_BLASTR_READY_URL": "",
    "ENABLE_SFS_ALBY": "false",
    "ALBY_BASE_URL": "",
    "ALBY_ROUTING_PROFILE": "",
    "ALBY_HUB_NAME": "",
    "ALBY_HUB_REGION": "",
    "ENABLE_SFS_BTCPAY": "false",
    "BTCPAY_BASE_URL": "",
    "ENABLE_NOSTRMASH_API": "false",
    "NOSTRMASH_API_READY_URL": "",
    "ENABLE_NOSTRMASH_INGESTOR": "false",
    "ENABLE_NOSTRMASH_WORKER": "false",
    "ENABLE_NOSTRMASH_READ_GATEWAY": "false",
    "NOSTRMASH_READ_GATEWAY_URL": "",
    "ENABLE_NOSTRMASH_PUBLISH_GATEWAY": "false",
    "NOSTRMASH_PUBLISH_GATEWAY_URL": "",
    "ENABLE_NOSTRMASH_READ_GATEWAY_DEEP": "false",
    "NOSTRMASH_READ_GATEWAY_DEEP_URL": "",
    "ENABLE_NOSTRMASH_PUBLISH_GATEWAY_DEEP": "false",
    "NOSTRMASH_PUBLISH_GATEWAY_DEEP_URL": "",
  },
  "secrets": {
    "required": [
      "OPERATOR_TOKEN",
      "STATUS_SIGNING_SECRET",
      "STATUS_READ_TOKEN",
      "SFS_BOT_NSEC",
      "NOSTRMASH_BOT_NSEC",
      "HEARTBEAT_KEYS",
      "HEARTBEAT_KEYS_PREVIOUS",
      "ALBY_AUTH_TOKEN",
      "BTCPAY_API_KEY",
      "TELEGRAM_BOT_TOKEN",
      "TELEGRAM_CHAT_IDS",
      "GITHUB_TOKEN",
    ],
  },
  "env": {
    "staging": {
      "name": "nostr-watchdog-staging",
      "limits": { "cpu_ms": 30000 },
      "observability": {
        "enabled": true,
        "logs": { "enabled": true, "head_sampling_rate": 1 },
        "traces": { "enabled": true, "head_sampling_rate": 1 },
      },
      "triggers": { "crons": ["* * * * *", "0 * * * *"] },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "nostr-watchdog-staging",
          "database_id": "00000000-0000-4000-8000-000000000002",
          "migrations_dir": "migrations",
        },
      ],
      "vars": {
        "ENVIRONMENT": "staging",
        "WATCHDOG_ENABLED": "true",
        "ALERTS_ENABLED": "true",
        "ADMIN_NPUB": "",
        "PROJECT_RECIPIENTS": "{}",
        "CHECK_CONCURRENCY": "4",
        "CHECK_TIMEOUT_MS": "5000",
        "FAILURE_THRESHOLD": "",
        "RECOVERY_THRESHOLD": "",
        "RELAY_LIST_TTL_SECONDS": "3600",
        "HEARTBEAT_MAX_SKEW_SECONDS": "300",
        "HEARTBEAT_MAX_BODY_BYTES": "4096",
        "HEARTBEAT_STALE_SECONDS": "180",
        "HEARTBEAT_PROGRESS_SECONDS": "600",
        "CRITICAL_REMINDER_SECONDS": "0",
        "UNKNOWN_THRESHOLD": "5",
        "DELIVERY_CLAIM_MS": "120000",
        "SCHEDULER_STALE_SECONDS": "180",
        "TELEGRAM_CRITICAL_MODE": "dual",
        "BOOTSTRAP_RELAYS": "",
        "GITHUB_API_BASE": "https://api.github.com",
        "PRIVATE_NETWORK_PROFILE": "false",
        "RUNBOOK_BASE_URL": "",
        "ENABLE_SFS_WEB": "false",
        "SFS_WEB_READY_URL": "",
        "ENABLE_SFS_WORKER": "false",
        "ENABLE_SFS_BLOSSOM": "false",
        "SFS_BLOSSOM_READY_URL": "",
        "ENABLE_SFS_BLASTR": "false",
        "SFS_BLASTR_READY_URL": "",
        "ENABLE_SFS_ALBY": "false",
        "ALBY_BASE_URL": "",
        "ALBY_ROUTING_PROFILE": "",
        "ALBY_HUB_NAME": "",
        "ALBY_HUB_REGION": "",
        "ENABLE_SFS_BTCPAY": "false",
        "BTCPAY_BASE_URL": "",
        "ENABLE_NOSTRMASH_API": "false",
        "NOSTRMASH_API_READY_URL": "",
        "ENABLE_NOSTRMASH_INGESTOR": "false",
        "ENABLE_NOSTRMASH_WORKER": "false",
        "ENABLE_NOSTRMASH_READ_GATEWAY": "false",
        "NOSTRMASH_READ_GATEWAY_URL": "",
        "ENABLE_NOSTRMASH_PUBLISH_GATEWAY": "false",
        "NOSTRMASH_PUBLISH_GATEWAY_URL": "",
        "ENABLE_NOSTRMASH_READ_GATEWAY_DEEP": "false",
        "NOSTRMASH_READ_GATEWAY_DEEP_URL": "",
        "ENABLE_NOSTRMASH_PUBLISH_GATEWAY_DEEP": "false",
        "NOSTRMASH_PUBLISH_GATEWAY_DEEP_URL": "",
      },
      "secrets": {
        "required": [
          "OPERATOR_TOKEN",
          "STATUS_SIGNING_SECRET",
          "STATUS_READ_TOKEN",
          "SFS_BOT_NSEC",
          "NOSTRMASH_BOT_NSEC",
          "HEARTBEAT_KEYS",
          "HEARTBEAT_KEYS_PREVIOUS",
          "ALBY_AUTH_TOKEN",
          "BTCPAY_API_KEY",
          "TELEGRAM_BOT_TOKEN",
          "TELEGRAM_CHAT_IDS",
          "GITHUB_TOKEN",
        ],
      },
    },
    "production": {
      "name": "nostr-watchdog",
      "limits": { "cpu_ms": 30000 },
      "observability": {
        "enabled": true,
        "logs": { "enabled": true, "head_sampling_rate": 1 },
        "traces": { "enabled": true, "head_sampling_rate": 1 },
      },
      "triggers": { "crons": ["* * * * *", "0 * * * *"] },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "nostr-watchdog",
          "database_id": "00000000-0000-4000-8000-000000000003",
          "migrations_dir": "migrations",
        },
      ],
      "vars": {
        "ENVIRONMENT": "production",
        "WATCHDOG_ENABLED": "true",
