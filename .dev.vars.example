STATUS_READ_TOKEN=
STATUS_SIGNING_SECRET=
SFS_BOT_NSEC=
NOSTRMASH_BOT_NSEC=
HEARTBEAT_KEYS=
HEARTBEAT_KEYS_PREVIOUS=
ALBY_AUTH_TOKEN=
BTCPAY_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
GITHUB_TOKEN=
READ_GATEWAY_HEALTH_TOKEN=
PUBLISH_GATEWAY_HEALTH_TOKEN=

# Optional non-secret overrides. Real service URLs stay out of git.
# ADMIN_NPUB=npub1...
# PROJECT_RECIPIENTS={"smartflowsocial":"npub1...","nostrmash":"npub1..."}
# BOOTSTRAP_RELAYS=wss://relay.example,wss://relay-two.example
